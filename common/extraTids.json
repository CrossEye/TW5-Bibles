[
  {
    "title": "${title}",
    "tags": "${TableOfContents}",
    "text": "<div class=\"tc-table-of-contents\" style=\"column-width:12em;\">\n\n<<toc-selective-expandable \"${Book}\" \"nsort[seq]\" >>\n\n</div>\n"
  },
  {
    "title": "${Book}",
    "tags": "${TableOfContents}",
    "caption": "${Books}"
  },
  {
    "title": "${TableOfContents}",
    "tags": "$:/tags/SideBar",
    "caption": "${Contents}",
    "list": "[[${title}]] [[${Book}]]",
    "list-before": "$:/core/ui/SideBar/Open",
    "text": "<div class=\"tc-table-of-contents\">\n\n<<toc-selective-expandable \"${TableOfContents}\" \"nsort[seq]\" >>\n\n</div>\n"
  },
  {
    "title": "$:/config/DefaultSidebarTab",
    "tags": "",
    "bag": "default",
    "text": "${TableOfContents}"
  },
  {
    "title": "$:/DefaultTiddlers",
    "tags": "",
    "text": "[[${title}]]"
  },
  {
    "title": "$:/SiteSubtitle",
    "tags": "",
    "text": ""
  },
  {
    "title": "$:/SiteTitle",
    "tags": "",
    "text": "${title}"
  },
  {
    "title": "$:/_/bible-wiki/procedures/open-verse",
    "tags": "$:/tags/Global",
    "text": "\\procedure open-verse()\n<$action-navigate $to=<<dom-title>>/>\n\\end\n"
  },
  {
    "title": "$:/_/bible-wiki/styles/basic",
    "tags": "$:/tags/Stylesheet",
    "type": "text/css",
    "text": ".chapter.poetry {\n  p {margin: .1em 1em; width: 25em; text-indent: 1.25em;}\n  p.stanza {margin: 2em 0 1em; font-weight: 500;}\n  p.inscription {background: #f0f0f0; padding: .25em; text-indent: .25em;}\n}\n.verse {padding-right: .3em;}\n.verse:hover {\n  background: #dfd;\n  cursor: pointer;\n}\n\n"
  },
  {
    "title": "$:/_/bible-wiki/templates/book",
    "tags": "$:/tags/ViewTemplate",
    "text": "<% if [<currentTiddler>tag{$:/language/plugins/crosseye/bible-wiki/Book}] %>\n<$list filter=\"[tag{$:/language/plugins/crosseye/bible-wiki/Chapter}] :filter[book<..currentTiddler>] +[nsort[seq]]\">\n<$let header={{{ [<currentTiddler>book{$:/language/plugins/crosseye/bible-wiki/books/Psalms}then{$:/language/plugins/crosseye/bible-wiki/Psalm}else{$:/language/plugins/crosseye/bible-wiki/Chapter}] }}} >\n<h2><$link><<header>> {{!!chapter}}</$link></h2>\n<$transclude $tiddler=\"$:/_/bible-wiki/templates/chapter\" />\n</$let>\n</$list>\n<% endif %>"
  },
  {
    "title": "$:/_/bible-wiki/templates/chapter",
    "tags": "$:/tags/ViewTemplate",
    "text": "\\whitespace trim\n<% if [<currentTiddler>tag{$:/language/plugins/crosseye/bible-wiki/Chapter}] %>\n<$let template={{{[<currentTiddler>book{$:/language/plugins/crosseye/bible-wiki/books/Psalms}then[$:/_/bible-wiki/templates/psalms]else[$:/_/bible-wiki/templates/most-books]] }}} >\n<% if [book{$:/language/plugins/crosseye/bible-wiki/books/Psalms}psalm-section{!!psalm-section}first[]chapter{!!chapter}] %>\n<h3>{{!!psalm-section}}</h3>\n<% endif %>\n\n<$transclude $tiddler=<<template>> />\n</$let>\n<% endif %>"
  },
  {
    "tags": "",
    "title": "$:/_/bible-wiki/templates/most-books",
    "code-body": "yes",
    "text": "<$eventcatcher selector=\"span.verse\" $click=<<open-verse>>  tag=\"div\" class=\"chapter\" >\n<$set name=verses filter=\"[<currentTiddler>tagging[]tag{$:/language/plugins/crosseye/bible-wiki/Verse}!has[draft.of]]\">\n<$list filter=\"[enlist<verses>get[para]unique[]nsort[]]\" variable=\"thisPara\">\n  <p><$list filter=\"[enlist<verses>para<thisPara>nsort[seq]]\">\n    <span class=\"verse\" title={{!!title}}>{{!!text}}</span>\n  </$list></p>\n</$list>\n</$set>\n</$eventcatcher>\n"
  },
  {
    "title": "$:/_/bible-wiki/templates/psalms",
    "tags": "",
    "code-body": "yes",
    "text": "<$eventcatcher selector=\"span.verse\" $click=<<open-verse>>  tag=\"div\" class=\"chapter poetry\">\n<% if [<currentTiddler>has[inscription]] %>\n<p class=\"inscription\">{{!!inscription}}</p><br/>\n<% endif %>\n<$list filter=\"[<currentTiddler>tagging[]tag{$:/language/plugins/crosseye/bible-wiki/Verse}nsort[seq]]\">\n<% if [<currentTiddler>has[preface]]%>\n  <p class=\"stanza\">{{!!preface}}</p>\n<% endif %>\n  <p>\n    <span class=\"verse\" title={{!!title}}>{{!!text}}</span>\n  </p>\n</$list>\n</$eventcatcher>\n"
  },
  {
    "title": "$:/_/my/filters/export",
    "tags": "",
    "text": "[[${title}]] ${Book} ${TableOfContents} $:/config/DefaultSidebarTab $:/DefaultTiddlers  $:/SiteSubtitle $:/SiteTitle [prefix[$:/_/bible]] $:/_/my/filters/export "
  }
]